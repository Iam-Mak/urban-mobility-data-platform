{
	"$schema": "http://schema.management.azure.com/schemas/2015-01-01/deploymentTemplate.json#",
	"contentVersion": "1.0.0.0",
	"parameters": {
		"factoryName": {
			"type": "string",
			"metadata": "Data Factory name",
			"defaultValue": "adf-dubmob-dev-002"
		},
		"AzureDataLakeStorage1_accountKey": {
			"type": "secureString",
			"metadata": "Secure string for 'accountKey' of 'AzureDataLakeStorage1'"
		},
		"AzureDataLakeStorage1_properties_typeProperties_url": {
			"type": "string",
			"defaultValue": "https://dubmobdev002.dfs.core.windows.net/"
		},
		"LS_HTTP_DublinBikes_API_properties_typeProperties_url": {
			"type": "string",
			"defaultValue": "https://data.smartdublin.ie"
		},
		"ls_smart_dublin_http_properties_typeProperties_url": {
			"type": "string",
			"defaultValue": "https://data.smartdublin.ie"
		}
	},
	"variables": {
		"factoryId": "[concat('Microsoft.DataFactory/factories/', parameters('factoryName'))]"
	},
	"resources": [
		{
			"name": "[concat(parameters('factoryName'), '/AzureDataLakeStorage1')]",
			"type": "Microsoft.DataFactory/factories/linkedServices",
			"apiVersion": "2018-06-01",
			"properties": {
				"annotations": [],
				"type": "AzureBlobFS",
				"typeProperties": {
					"url": "[parameters('AzureDataLakeStorage1_properties_typeProperties_url')]",
					"accountKey": {
						"type": "SecureString",
						"value": "[parameters('AzureDataLakeStorage1_accountKey')]"
					}
				}
			},
			"dependsOn": []
		},
		{
			"name": "[concat(parameters('factoryName'), '/LS_HTTP_DublinBikes_API')]",
			"type": "Microsoft.DataFactory/factories/linkedServices",
			"apiVersion": "2018-06-01",
			"properties": {
				"annotations": [],
				"type": "HttpServer",
				"typeProperties": {
					"url": "[parameters('LS_HTTP_DublinBikes_API_properties_typeProperties_url')]",
					"enableServerCertificateValidation": true,
					"authenticationType": "Anonymous"
				}
			},
			"dependsOn": []
		},
		{
			"name": "[concat(parameters('factoryName'), '/ls_smart_dublin_http')]",
			"type": "Microsoft.DataFactory/factories/linkedServices",
			"apiVersion": "2018-06-01",
			"properties": {
				"annotations": [],
				"type": "HttpServer",
				"typeProperties": {
					"url": "[parameters('ls_smart_dublin_http_properties_typeProperties_url')]",
					"enableServerCertificateValidation": true,
					"authenticationType": "Anonymous"
				}
			},
			"dependsOn": []
		},
		{
			"name": "[concat(parameters('factoryName'), '/DestinationDataset_afz')]",
			"type": "Microsoft.DataFactory/factories/datasets",
			"apiVersion": "2018-06-01",
			"properties": {
				"linkedServiceName": {
					"referenceName": "AzureDataLakeStorage1",
					"type": "LinkedServiceReference"
				},
				"annotations": [],
				"type": "DelimitedText",
				"typeProperties": {
					"location": {
						"type": "AzureBlobFSLocation",
						"fileName": "adf_dublin_bikes_station_status_052026.csv",
						"folderPath": "dublinbikes/year=2026/month=05",
						"fileSystem": "landing"
					},
					"columnDelimiter": ",",
					"escapeChar": "\\",
					"firstRowAsHeader": true,
					"quoteChar": "\""
				},
				"schema": []
			},
			"dependsOn": [
				"[concat(variables('factoryId'), '/linkedServices/AzureDataLakeStorage1')]"
			]
		},
		{
			"name": "[concat(parameters('factoryName'), '/DestinationDataset_xjg')]",
			"type": "Microsoft.DataFactory/factories/datasets",
			"apiVersion": "2018-06-01",
			"properties": {
				"linkedServiceName": {
					"referenceName": "AzureDataLakeStorage1",
					"type": "LinkedServiceReference"
				},
				"parameters": {
					"StartDate": {
						"type": "string",
						"defaultValue": "2026-05-01"
					},
					"EndDate": {
						"type": "string",
						"defaultValue": "2026-05-31"
					}
				},
				"annotations": [],
				"type": "DelimitedText",
				"typeProperties": {
					"location": {
						"type": "AzureBlobFSLocation",
						"fileName": {
							"value": "@concat('dublin_bikes_',dataset().StartDate,'_to_',dataset().EndDate,'.csv')",
							"type": "Expression"
						},
						"folderPath": {
							"value": "@concat(\n'dublinbikes/year=',\nsubstring(dataset().StartDate,0,4),\n'/month=',\nsubstring(dataset().StartDate,5,2)\n)",
							"type": "Expression"
						},
						"fileSystem": "landing"
					},
					"columnDelimiter": ",",
					"escapeChar": "\\",
					"firstRowAsHeader": true,
					"quoteChar": "\""
				},
				"schema": []
			},
			"dependsOn": [
				"[concat(variables('factoryId'), '/linkedServices/AzureDataLakeStorage1')]"
			]
		},
		{
			"name": "[concat(parameters('factoryName'), '/SourceDataset_afz')]",
			"type": "Microsoft.DataFactory/factories/datasets",
			"apiVersion": "2018-06-01",
			"properties": {
				"linkedServiceName": {
					"referenceName": "ls_smart_dublin_http",
					"type": "LinkedServiceReference"
				},
				"annotations": [],
				"type": "DelimitedText",
				"typeProperties": {
					"location": {
						"type": "HttpServerLocation",
						"relativeUrl": "dataset/33ec9fe2-4957-4e9a-ab55-c5e917c7a9ab/resource/03dd67ef-33b0-4102-8329-42c67fdbf53e/download/dublin-bikes_station_status_052026.csv"
					},
					"columnDelimiter": ",",
					"escapeChar": "\\",
					"firstRowAsHeader": true,
					"quoteChar": "\""
				},
				"schema": [
					{
						"name": "system_id",
						"type": "String"
					},
					{
						"name": "last_reported",
						"type": "String"
					},
					{
						"name": "station_id",
						"type": "String"
					},
					{
						"name": "num_bikes_available",
						"type": "String"
					},
					{
						"name": "num_docks_available",
						"type": "String"
					},
					{
						"name": "is_installed",
						"type": "String"
					},
					{
						"name": "is_renting",
						"type": "String"
					},
					{
						"name": "is_returning",
						"type": "String"
					},
					{
						"name": "name",
						"type": "String"
					},
					{
						"name": "short_name",
						"type": "String"
					},
					{
						"name": "address",
						"type": "String"
					},
					{
						"name": "lat",
						"type": "String"
					},
					{
						"name": "lon",
						"type": "String"
					},
					{
						"name": "region_id",
						"type": "String"
					},
					{
						"name": "capacity",
						"type": "String"
					}
				]
			},
			"dependsOn": [
				"[concat(variables('factoryId'), '/linkedServices/ls_smart_dublin_http')]"
			]
		},
		{
			"name": "[concat(parameters('factoryName'), '/SourceDataset_xjg')]",
			"type": "Microsoft.DataFactory/factories/datasets",
			"apiVersion": "2018-06-01",
			"properties": {
				"linkedServiceName": {
					"referenceName": "LS_HTTP_DublinBikes_API",
					"type": "LinkedServiceReference"
				},
				"parameters": {
					"StartDate": {
						"type": "string",
						"defaultValue": "2026-05-01"
					},
					"EndDate": {
						"type": "string",
						"defaultValue": "2026-05-31"
					}
				},
				"annotations": [],
				"type": "DelimitedText",
				"typeProperties": {
					"location": {
						"type": "HttpServerLocation",
						"relativeUrl": {
							"value": "@concat('dublinbikes-api/bikes/dublin_bikes/historical/stations.csv?dt_start=',dataset().StartDate,'&dt_end=',dataset().EndDate)",
							"type": "Expression"
						}
					},
					"columnDelimiter": ",",
					"rowDelimiter": "\n",
					"escapeChar": "\\",
					"firstRowAsHeader": true,
					"quoteChar": "\""
				},
				"schema": [
					{
						"name": "system_id",
						"type": "String"
					},
					{
						"name": "last_reported",
						"type": "String"
					},
					{
						"name": "station_id",
						"type": "String"
					},
					{
						"name": "num_bikes_available",
						"type": "String"
					},
					{
						"name": "num_docks_available",
						"type": "String"
					},
					{
						"name": "is_installed",
						"type": "String"
					},
					{
						"name": "is_renting",
						"type": "String"
					},
					{
						"name": "is_returning",
						"type": "String"
					},
					{
						"name": "name",
						"type": "String"
					},
					{
						"name": "short_name",
						"type": "String"
					},
					{
						"name": "address",
						"type": "String"
					},
					{
						"name": "lat",
						"type": "String"
					},
					{
						"name": "lon",
						"type": "String"
					},
					{
						"name": "region_id",
						"type": "String"
					},
					{
						"name": "capacity",
						"type": "String"
					}
				]
			},
			"dependsOn": [
				"[concat(variables('factoryId'), '/linkedServices/LS_HTTP_DublinBikes_API')]"
			]
		},
		{
			"name": "[concat(parameters('factoryName'), '/Copy_DublinBikes_API_To_Landing')]",
			"type": "Microsoft.DataFactory/factories/pipelines",
			"apiVersion": "2018-06-01",
			"properties": {
				"activities": [
					{
						"name": "PL_DublinBikes_API",
						"type": "Copy",
						"dependsOn": [],
						"policy": {
							"timeout": "0.12:00:00",
							"retry": 0,
							"retryIntervalInSeconds": 30,
							"secureOutput": false,
							"secureInput": false
						},
						"userProperties": [
							{
								"name": "Source",
								"value": "dublinbikes-api/bikes/dublin_bikes/historical/stations.csv"
							},
							{
								"name": "Destination",
								"value": "landing/dublinbikes/year=2026/month=05/dublin_bikes_api.csv"
							}
						],
						"typeProperties": {
							"source": {
								"type": "DelimitedTextSource",
								"storeSettings": {
									"type": "HttpReadSettings",
									"requestMethod": "GET"
								},
								"formatSettings": {
									"type": "DelimitedTextReadSettings",
									"skipLineCount": 0
								}
							},
							"sink": {
								"type": "DelimitedTextSink",
								"storeSettings": {
									"type": "AzureBlobFSWriteSettings"
								},
								"formatSettings": {
									"type": "DelimitedTextWriteSettings",
									"quoteAllText": true,
									"fileExtension": ".txt"
								}
							},
							"enableStaging": false,
							"translator": {
								"type": "TabularTranslator",
								"typeConversion": true,
								"typeConversionSettings": {
									"allowDataTruncation": true,
									"treatBooleanAsNumber": false
								}
							}
						},
						"inputs": [
							{
								"referenceName": "SourceDataset_xjg",
								"type": "DatasetReference",
								"parameters": {
									"StartDate": {
										"value": "@pipeline().parameters.pStartDate",
										"type": "Expression"
									},
									"EndDate": {
										"value": "@pipeline().parameters.pEndDate",
										"type": "Expression"
									}
								}
							}
						],
						"outputs": [
							{
								"referenceName": "DestinationDataset_xjg",
								"type": "DatasetReference",
								"parameters": {
									"StartDate": "@pipeline().parameters.pStartDate",
									"EndDate": "@pipeline().parameters.pEndDate"
								}
							}
						]
					}
				],
				"policy": {
					"elapsedTimeMetric": {}
				},
				"parameters": {
					"pStartDate": {
						"type": "string",
						"defaultValue": "2026-05-01"
					},
					"pEndDate": {
						"type": "string",
						"defaultValue": "2026-05-31"
					}
				},
				"annotations": [],
				"lastPublishTime": "2026-07-18T11:18:14Z"
			},
			"dependsOn": [
				"[concat(variables('factoryId'), '/datasets/SourceDataset_xjg')]",
				"[concat(variables('factoryId'), '/datasets/DestinationDataset_xjg')]"
			]
		},
		{
			"name": "[concat(parameters('factoryName'), '/Copy_Dublin_Bikes_CSV')]",
			"type": "Microsoft.DataFactory/factories/pipelines",
			"apiVersion": "2018-06-01",
			"properties": {
				"description": "Copies Dublin Bikes CSV from Smart Dublin HTTP source to ADLS Gen2 landing zone.",
				"activities": [
					{
						"name": "Copy_afz",
						"type": "Copy",
						"dependsOn": [],
						"policy": {
							"timeout": "0.12:00:00",
							"retry": 0,
							"retryIntervalInSeconds": 30,
							"secureOutput": false,
							"secureInput": false
						},
						"userProperties": [
							{
								"name": "Source",
								"value": "dataset/33ec9fe2-4957-4e9a-ab55-c5e917c7a9ab/resource/03dd67ef-33b0-4102-8329-42c67fdbf53e/download/dublin-bikes_station_status_052026.csv"
							},
							{
								"name": "Destination",
								"value": "landing/dublinbikes/year=2026/month=05/adf_dublin_bikes_station_status_052026.csv"
							}
						],
						"typeProperties": {
							"source": {
								"type": "DelimitedTextSource",
								"storeSettings": {
									"type": "HttpReadSettings",
									"requestMethod": "GET"
								},
								"formatSettings": {
									"type": "DelimitedTextReadSettings",
									"skipLineCount": 0
								}
							},
							"sink": {
								"type": "DelimitedTextSink",
								"storeSettings": {
									"type": "AzureBlobFSWriteSettings",
									"copyBehavior": "FlattenHierarchy"
								},
								"formatSettings": {
									"type": "DelimitedTextWriteSettings",
									"quoteAllText": true,
									"fileExtension": ".txt"
								}
							},
							"enableStaging": false,
							"translator": {
								"type": "TabularTranslator",
								"typeConversion": true,
								"typeConversionSettings": {
									"allowDataTruncation": true,
									"treatBooleanAsNumber": false
								}
							}
						},
						"inputs": [
							{
								"referenceName": "SourceDataset_afz",
								"type": "DatasetReference",
								"parameters": {}
							}
						],
						"outputs": [
							{
								"referenceName": "DestinationDataset_afz",
								"type": "DatasetReference",
								"parameters": {}
							}
						]
					}
				],
				"policy": {
					"elapsedTimeMetric": {}
				},
				"annotations": [],
				"lastPublishTime": "2026-07-17T17:23:28Z"
			},
			"dependsOn": [
				"[concat(variables('factoryId'), '/datasets/SourceDataset_afz')]",
				"[concat(variables('factoryId'), '/datasets/DestinationDataset_afz')]"
			]
		}
	]
}