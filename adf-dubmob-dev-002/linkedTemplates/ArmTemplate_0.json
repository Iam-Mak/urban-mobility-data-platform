{
	"$schema": "http://schema.management.azure.com/schemas/2015-01-01/deploymentTemplate.json#",
	"contentVersion": "1.0.0.0",
	"parameters": {
		"factoryName": {
			"type": "string",
			"metadata": "Data Factory name",
			"defaultValue": "adf-dubmob-dev-002"
		},
		"AzureDataLakeStorage1_accountKey": {
			"type": "secureString",
			"metadata": "Secure string for 'accountKey' of 'AzureDataLakeStorage1'"
		},
		"AzureDataLakeStorage1_properties_typeProperties_url": {
			"type": "string",
			"defaultValue": "https://dubmobdev002.dfs.core.windows.net/"
		},
		"LS_HTTP_DublinBikes_API_properties_typeProperties_url": {
			"type": "string",
			"defaultValue": "https://data.smartdublin.ie"
		},
		"LS_OpenMeteo_HTTP_properties_typeProperties_url": {
			"type": "string",
			"defaultValue": "https://archive-api.open-meteo.com"
		}
	},
	"variables": {
		"factoryId": "[concat('Microsoft.DataFactory/factories/', parameters('factoryName'))]"
	},
	"resources": [
		{
			"name": "[concat(parameters('factoryName'), '/AzureDataLakeStorage1')]",
			"type": "Microsoft.DataFactory/factories/linkedServices",
			"apiVersion": "2018-06-01",
			"properties": {
				"annotations": [],
				"type": "AzureBlobFS",
				"typeProperties": {
					"url": "[parameters('AzureDataLakeStorage1_properties_typeProperties_url')]",
					"accountKey": {
						"type": "SecureString",
						"value": "[parameters('AzureDataLakeStorage1_accountKey')]"
					}
				}
			},
			"dependsOn": []
		},
		{
			"name": "[concat(parameters('factoryName'), '/LS_HTTP_DublinBikes_API')]",
			"type": "Microsoft.DataFactory/factories/linkedServices",
			"apiVersion": "2018-06-01",
			"properties": {
				"annotations": [],
				"type": "HttpServer",
				"typeProperties": {
					"url": "[parameters('LS_HTTP_DublinBikes_API_properties_typeProperties_url')]",
					"enableServerCertificateValidation": true,
					"authenticationType": "Anonymous"
				}
			},
			"dependsOn": []
		},
		{
			"name": "[concat(parameters('factoryName'), '/LS_OpenMeteo_HTTP')]",
			"type": "Microsoft.DataFactory/factories/linkedServices",
			"apiVersion": "2018-06-01",
			"properties": {
				"annotations": [],
				"type": "HttpServer",
				"typeProperties": {
					"url": "[parameters('LS_OpenMeteo_HTTP_properties_typeProperties_url')]",
					"enableServerCertificateValidation": true,
					"authenticationType": "Anonymous"
				}
			},
			"dependsOn": []
		},
		{
			"name": "[concat(parameters('factoryName'), '/DS_Dublin_Bikes_API')]",
			"type": "Microsoft.DataFactory/factories/datasets",
			"apiVersion": "2018-06-01",
			"properties": {
				"linkedServiceName": {
					"referenceName": "LS_HTTP_DublinBikes_API",
					"type": "LinkedServiceReference"
				},
				"parameters": {
					"StartDate": {
						"type": "string",
						"defaultValue": "2026-05-01"
					},
					"EndDate": {
						"type": "string",
						"defaultValue": "2026-05-31"
					}
				},
				"annotations": [],
				"type": "DelimitedText",
				"typeProperties": {
					"location": {
						"type": "HttpServerLocation",
						"relativeUrl": {
							"value": "@concat('dublinbikes-api/bikes/dublin_bikes/historical/stations.csv?dt_start=',dataset().StartDate,'&dt_end=',dataset().EndDate)",
							"type": "Expression"
						}
					},
					"columnDelimiter": ",",
					"rowDelimiter": "\n",
					"escapeChar": "\\",
					"firstRowAsHeader": true,
					"quoteChar": "\""
				},
				"schema": [
					{
						"name": "system_id",
						"type": "String"
					},
					{
						"name": "last_reported",
						"type": "String"
					},
					{
						"name": "station_id",
						"type": "String"
					},
					{
						"name": "num_bikes_available",
						"type": "String"
					},
					{
						"name": "num_docks_available",
						"type": "String"
					},
					{
						"name": "is_installed",
						"type": "String"
					},
					{
						"name": "is_renting",
						"type": "String"
					},
					{
						"name": "is_returning",
						"type": "String"
					},
					{
						"name": "name",
						"type": "String"
					},
					{
						"name": "short_name",
						"type": "String"
					},
					{
						"name": "address",
						"type": "String"
					},
					{
						"name": "lat",
						"type": "String"
					},
					{
						"name": "lon",
						"type": "String"
					},
					{
						"name": "region_id",
						"type": "String"
					},
					{
						"name": "capacity",
						"type": "String"
					}
				]
			},
			"dependsOn": [
				"[concat(variables('factoryId'), '/linkedServices/LS_HTTP_DublinBikes_API')]"
			]
		},
		{
			"name": "[concat(parameters('factoryName'), '/DS_Dublin_Bikes_Landing')]",
			"type": "Microsoft.DataFactory/factories/datasets",
			"apiVersion": "2018-06-01",
			"properties": {
				"linkedServiceName": {
					"referenceName": "AzureDataLakeStorage1",
					"type": "LinkedServiceReference"
				},
				"parameters": {
					"StartDate": {
						"type": "string",
						"defaultValue": "2026-05-01"
					},
					"EndDate": {
						"type": "string",
						"defaultValue": "2026-05-31"
					}
				},
				"annotations": [],
				"type": "DelimitedText",
				"typeProperties": {
					"location": {
						"type": "AzureBlobFSLocation",
						"fileName": {
							"value": "@concat('dublin_bikes_',dataset().StartDate,'_to_',dataset().EndDate,'.csv')",
							"type": "Expression"
						},
						"folderPath": {
							"value": "@concat(\n'dublinbikes/year=',\nsubstring(dataset().StartDate,0,4),\n'/month=',\nsubstring(dataset().StartDate,5,2)\n)",
							"type": "Expression"
						},
						"fileSystem": "landing"
					},
					"columnDelimiter": ",",
					"escapeChar": "\\",
					"firstRowAsHeader": true,
					"quoteChar": "\""
				},
				"schema": []
			},
			"dependsOn": [
				"[concat(variables('factoryId'), '/linkedServices/AzureDataLakeStorage1')]"
			]
		},
		{
			"name": "[concat(parameters('factoryName'), '/DS_Historical_Weather_API')]",
			"type": "Microsoft.DataFactory/factories/datasets",
			"apiVersion": "2018-06-01",
			"properties": {
				"linkedServiceName": {
					"referenceName": "LS_OpenMeteo_HTTP",
					"type": "LinkedServiceReference"
				},
				"parameters": {
					"StartDate": {
						"type": "string",
						"defaultValue": "2026-05-01"
					},
					"EndDate": {
						"type": "string",
						"defaultValue": "2026-05-31"
					}
				},
				"annotations": [],
				"type": "Json",
				"typeProperties": {
					"location": {
						"type": "HttpServerLocation",
						"relativeUrl": {
							"value": "@concat(\n'/v1/era5?latitude=53.3498',\n'&longitude=-6.2603',\n'&start_date=',dataset().StartDate,\n'&end_date=',dataset().EndDate,\n'&hourly=temperature_2m,precipitation,wind_speed_10m'\n)",
							"type": "Expression"
						}
					}
				},
				"schema": {}
			},
			"dependsOn": [
				"[concat(variables('factoryId'), '/linkedServices/LS_OpenMeteo_HTTP')]"
			]
		},
		{
			"name": "[concat(parameters('factoryName'), '/DS_Historical_Weather_Landing')]",
			"type": "Microsoft.DataFactory/factories/datasets",
			"apiVersion": "2018-06-01",
			"properties": {
				"linkedServiceName": {
					"referenceName": "AzureDataLakeStorage1",
					"type": "LinkedServiceReference"
				},
				"parameters": {
					"StartDate": {
						"type": "string"
					},
					"EndDate": {
						"type": "string"
					}
				},
				"annotations": [],
				"type": "Json",
				"typeProperties": {
					"location": {
						"type": "AzureBlobFSLocation",
						"fileName": {
							"value": "@concat(\n'historical_weather_',\ndataset().StartDate,\n'_to_',\ndataset().EndDate,\n'.json'\n)",
							"type": "Expression"
						},
						"folderPath": {
							"value": "@concat(\n'weather/year=',\nsubstring(dataset().StartDate,0,4),\n'/month=',\nsubstring(dataset().StartDate,5,2)\n)",
							"type": "Expression"
						},
						"fileSystem": "landing"
					}
				},
				"schema": {}
			},
			"dependsOn": [
				"[concat(variables('factoryId'), '/linkedServices/AzureDataLakeStorage1')]"
			]
		},
		{
			"name": "[concat(parameters('factoryName'), '/PL_DublinBikes_API')]",
			"type": "Microsoft.DataFactory/factories/pipelines",
			"apiVersion": "2018-06-01",
			"properties": {
				"activities": [
					{
						"name": "Copy_DublinBikes_To_Landing",
						"type": "Copy",
						"dependsOn": [],
						"policy": {
							"timeout": "0.12:00:00",
							"retry": 0,
							"retryIntervalInSeconds": 30,
							"secureOutput": false,
							"secureInput": false
						},
						"userProperties": [
							{
								"name": "Source",
								"value": "dublinbikes-api/bikes/dublin_bikes/historical/stations.csv"
							},
							{
								"name": "Destination",
								"value": "landing/dublinbikes/year=2026/month=05/dublin_bikes_api.csv"
							}
						],
						"typeProperties": {
							"source": {
								"type": "DelimitedTextSource",
								"storeSettings": {
									"type": "HttpReadSettings",
									"requestMethod": "GET"
								},
								"formatSettings": {
									"type": "DelimitedTextReadSettings",
									"skipLineCount": 0
								}
							},
							"sink": {
								"type": "DelimitedTextSink",
								"storeSettings": {
									"type": "AzureBlobFSWriteSettings"
								},
								"formatSettings": {
									"type": "DelimitedTextWriteSettings",
									"quoteAllText": true,
									"fileExtension": ".txt"
								}
							},
							"enableStaging": false,
							"translator": {
								"type": "TabularTranslator",
								"typeConversion": true,
								"typeConversionSettings": {
									"allowDataTruncation": true,
									"treatBooleanAsNumber": false
								}
							}
						},
						"inputs": [
							{
								"referenceName": "DS_Dublin_Bikes_API",
								"type": "DatasetReference",
								"parameters": {
									"StartDate": {
										"value": "@pipeline().parameters.pStartDate",
										"type": "Expression"
									},
									"EndDate": {
										"value": "@pipeline().parameters.pEndDate",
										"type": "Expression"
									}
								}
							}
						],
						"outputs": [
							{
								"referenceName": "DS_Dublin_Bikes_Landing",
								"type": "DatasetReference",
								"parameters": {
									"StartDate": "@pipeline().parameters.pStartDate",
									"EndDate": "@pipeline().parameters.pEndDate"
								}
							}
						]
					}
				],
				"policy": {
					"elapsedTimeMetric": {}
				},
				"parameters": {
					"pStartDate": {
						"type": "string",
						"defaultValue": "2026-05-01"
					},
					"pEndDate": {
						"type": "string",
						"defaultValue": "2026-05-31"
					}
				},
				"annotations": [],
				"lastPublishTime": "2026-07-18T11:18:14Z"
			},
			"dependsOn": [
				"[concat(variables('factoryId'), '/datasets/DS_Dublin_Bikes_API')]",
				"[concat(variables('factoryId'), '/datasets/DS_Dublin_Bikes_Landing')]"
			]
		},
		{
			"name": "[concat(parameters('factoryName'), '/PL_Historical_Weather_API')]",
			"type": "Microsoft.DataFactory/factories/pipelines",
			"apiVersion": "2018-06-01",
			"properties": {
				"activities": [
					{
						"name": "Copy_Historical_Weather_To_Landing",
						"type": "Copy",
						"dependsOn": [],
						"policy": {
							"timeout": "0.12:00:00",
							"retry": 0,
							"retryIntervalInSeconds": 30,
							"secureOutput": false,
							"secureInput": false
						},
						"userProperties": [],
						"typeProperties": {
							"source": {
								"type": "JsonSource",
								"storeSettings": {
									"type": "HttpReadSettings",
									"requestMethod": "GET"
								},
								"formatSettings": {
									"type": "JsonReadSettings"
								}
							},
							"sink": {
								"type": "JsonSink",
								"storeSettings": {
									"type": "AzureBlobFSWriteSettings"
								},
								"formatSettings": {
									"type": "JsonWriteSettings"
								}
							},
							"enableStaging": false
						},
						"inputs": [
							{
								"referenceName": "DS_Historical_Weather_API",
								"type": "DatasetReference",
								"parameters": {
									"StartDate": {
										"value": "@pipeline().parameters.pStartDate",
										"type": "Expression"
									},
									"EndDate": {
										"value": "@pipeline().parameters.pEndDate",
										"type": "Expression"
									}
								}
							}
						],
						"outputs": [
							{
								"referenceName": "DS_Historical_Weather_Landing",
								"type": "DatasetReference",
								"parameters": {
									"StartDate": "@pipeline().parameters.pStartDate",
									"EndDate": "@pipeline().parameters.pEndDate"
								}
							}
						]
					}
				],
				"policy": {
					"elapsedTimeMetric": {}
				},
				"parameters": {
					"pStartDate": {
						"type": "string"
					},
					"pEndDate": {
						"type": "string"
					}
				},
				"annotations": []
			},
			"dependsOn": [
				"[concat(variables('factoryId'), '/datasets/DS_Historical_Weather_API')]",
				"[concat(variables('factoryId'), '/datasets/DS_Historical_Weather_Landing')]"
			]
		}
	]
}